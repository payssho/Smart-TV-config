<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fond « nuit » de la veilleuse dès le lancement : pas de flash blanc
         sur le mur quand le lanceur démarre. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/nuit</item>
    </style>
</resources>
